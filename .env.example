# Copy to .env and fill in. .env is gitignored; never commit it.

# Snowflake, key-pair auth
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=

# Databricks SQL warehouse
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Open-weight models: one of these is enough
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
